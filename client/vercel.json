{
  "redirects": [
    { "source": "/services/residential", "destination": "/services/domestic-cleaning", "permanent": true },
    { "source": "/services/end-of-tenancy", "destination": "/services/end-of-tenancy-cleaning", "permanent": true },
    { "source": "/services/airbnb", "destination": "/services/airbnb-cleaning", "permanent": true },
    { "source": "/services/commercial", "destination": "/services/commercial-cleaning", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=31536000" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
