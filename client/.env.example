# Client env: only VITE_* (public/publishable values). Never put server secrets here.
# API URL - leave empty for dev (Vite proxy forwards /api to backend)
# Production: point directly to backend service URL
VITE_API_URL=
# Optional production fallback host used only when VITE_API_URL is empty on non-localhost
VITE_API_URL_FALLBACK=

# reCAPTCHA v3 (client-side key - safe to expose)
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# Stripe publishable key (client-side - safe to expose)
VITE_STRIPE_PUBLIC_KEY=your_stripe_publishable_key_here

# Analytics (optional — only loads after user consents)
VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_CLARITY_PROJECT_ID=your_clarity_project_id

# Sentry (optional client-side error monitoring)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
# Keep this low in production unless you need deeper tracing
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
