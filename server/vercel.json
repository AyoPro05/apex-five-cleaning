{
  "version": 2,
  "builds": [
    {
      "src": "src/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["assets/apex-five-logo.png"]
      }
    }
  ],
  "crons": [{ "path": "/api/automation/run", "schedule": "0 8 * * *" }],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/index.js"
    }
  ]
}
