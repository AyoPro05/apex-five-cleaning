# Root environment template (placeholders only).
# Copy values into server/.env and client/.env as appropriate.

# ---------- Shared / Server ----------
NODE_ENV=<SET_NODE_ENV>
PORT=<SET_SERVER_PORT>
CLIENT_URL=<SET_CLIENT_URL>
MONGODB_URI=<SET_MONGODB_URI>
MONGODB_URI_DEV=<SET_DEV_MONGODB_URI>
