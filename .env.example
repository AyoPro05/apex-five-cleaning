PRODUCTION_CORS_ORIGINS=<SET_PRODUCTION_CORS_ORIGINS>
ADDITIONAL_CORS_ORIGINS=<SET_ADDITIONAL_CORS_ORIGINS>
RENDER_EXTERNAL_URL=<SET_RENDER_EXTERNAL_URL>

# Email
EMAIL_PROVIDER=<SET_EMAIL_PROVIDER>
SENDGRID_API_KEY=<SET_SENDGRID_API_KEY>
SENDGRID_FROM_EMAIL=<SET_SENDGRID_FROM_EMAIL>
